pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        githubPush()
    }

    environment {
        KUBE_NAMESPACE   = 'vle8-app'
        APP_NAME         = 'VLE-8 Blue-Green Deployment'
        IMAGE_REPO       = 'myapp'
        GREEN_VERSION    = 'v2'
        GREEN_IMAGE_TAG  = "v2-b${env.BUILD_NUMBER}"
        GREEN_IMAGE      = "myapp:v2-b${env.BUILD_NUMBER}"
        PROD_URL         = 'http://127.0.0.1'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm
                sh '''
                    echo "Checked out commit: $(git rev-parse --short HEAD 2>/dev/null || echo 'local')"
                    ls -la
                '''
            }
        }

        stage('2. Validate Application & Configuration') {
            steps {
                sh '''
                    set -euo pipefail
                    test -f docker/Dockerfile
                    test -f app/index.html.template
                    test -f app/nginx.conf.template
                    test -f app/docker-entrypoint-render.sh
                    bash -n app/docker-entrypoint-render.sh
                    for s in scripts/*.sh; do
                      bash -n "$s"
                    done
                    kubectl apply --dry-run=client -f kubernetes/namespace.yaml
                    kubectl apply --dry-run=client -f kubernetes/deployment-blue.yaml
                    kubectl apply --dry-run=client -f kubernetes/deployment-green.yaml
                    kubectl apply --dry-run=client -f kubernetes/service.yaml
                    echo "Validation of Dockerfile, shell scripts, and Kubernetes manifests PASSED."
                '''
            }
        }

        stage('3. Build Docker Image for Green / v2') {
            steps {
                sh '''
                    set -euo pipefail
                    docker build \
                      -f docker/Dockerfile \
                      --build-arg APP_COLOR=GREEN \
                      --build-arg APP_VERSION="${GREEN_VERSION}" \
                      --build-arg BUILD_TAG="${GREEN_IMAGE_TAG}" \
                      -t "${GREEN_IMAGE}" \
                      .
                    docker images "${IMAGE_REPO}"
                '''
            }
        }

        stage('4. Validate & Test Green Image') {
            steps {
                sh '''
                    set -euo pipefail
                    TEST_CTR="vle8-green-smoke-${BUILD_NUMBER}"
                    cleanup() {
                      docker rm -f "${TEST_CTR}" >/dev/null 2>&1 || true
                    }
                    trap cleanup EXIT

                    docker run -d --name "${TEST_CTR}" -p 18081:80 "${GREEN_IMAGE}"
                    for i in $(seq 1 15); do
                      if curl -fsS http://127.0.0.1:18081/health >/dev/null 2>&1; then
                        break
                      fi
                      sleep 1
                    done

                    HEALTH=$(curl -fsS http://127.0.0.1:18081/health)
                    echo "Container smoke test /health: ${HEALTH}"
                    echo "${HEALTH}" | grep -q '"status":"healthy"'
                    echo "${HEALTH}" | grep -q '"color":"GREEN"'
                    echo "${HEALTH}" | grep -q '"version":"v2"'
                    curl -fsS http://127.0.0.1:18081/ | grep -q 'GREEN'
                    echo "Docker image smoke test PASSED."
                '''
            }
        }

        stage('5. Deploy Green to Kubernetes') {
            steps {
                sh '''
                    set -euo pipefail
                    bash scripts/load-image-minikube.sh "${GREEN_IMAGE}"
                    kubectl apply -f kubernetes/namespace.yaml
                    kubectl apply -f kubernetes/deployment-green.yaml
                    kubectl set image -n "${KUBE_NAMESPACE}" deployment/myapp-green myapp="${GREEN_IMAGE}"
                '''
            }
        }

        stage('6. Wait for Green Rollout') {
            steps {
                sh '''
                    set -euo pipefail
                    kubectl rollout status -n "${KUBE_NAMESPACE}" deployment/myapp-green --timeout=180s
                    kubectl get deployments -n "${KUBE_NAMESPACE}"
                    kubectl get pods -n "${KUBE_NAMESPACE}" -l app=myapp,color=green -o wide
                '''
            }
        }

        stage('7. Verify Green Application Independently') {
            steps {
                sh '''
                    set -euo pipefail
                    echo "Confirming production service selector BEFORE switching:"
                    kubectl get service myapp-service -n "${KUBE_NAMESPACE}" -o jsonpath='{.spec.selector}'; echo
                    bash scripts/verify-green-independent.sh
                '''
            }
        }

        stage('8. Manual Approval') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        message: 'Switch production traffic to GREEN?',
                        ok: 'Switch to GREEN'
                    )
                }
            }
        }

        stage('9. Switch Service Selector from Blue to Green') {
            steps {
                sh '''
                    set -euo pipefail
                    bash scripts/switch-to-green.sh
                '''
            }
        }

        stage('10. Verify Production Traffic Returns GREEN / v2') {
            steps {
                sh '''
                    set -euo pipefail
                    sleep 2
                    bash scripts/verify-deployment.sh "${PROD_URL}" "GREEN" "v2"
                '''
            }
        }

        stage('11. Report Deployment Status') {
            steps {
                sh '''
                    set -euo pipefail
                    echo "=== Final VLE-8 Blue-Green Deployment Status ==="
                    kubectl get deployments,pods,svc,endpoints -n "${KUBE_NAMESPACE}" -o wide
                    echo "Active production URL response:"
                    curl -fsS "${PROD_URL}/api/info"; echo
                    echo "To rollback to BLUE immediately, run: bash scripts/switch-to-blue.sh"
                '''
            }
        }
    }

    post {
        failure {
            sh '''
                echo "=== PIPELINE FAILED — DIAGNOSTICS ==="
                kubectl get events -n "${KUBE_NAMESPACE}" --sort-by='.lastTimestamp' | tail -n 20 || true
                kubectl get pods -n "${KUBE_NAMESPACE}" -o wide || true
            '''
        }
    }
}
