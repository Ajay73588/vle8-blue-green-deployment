# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variable files and plans
*.tfvars
!terraform.tfvars.example
*.tfvars.json
tfplan*
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

