<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>__APP_NAME__ | __APP_COLOR__ (__APP_VERSION__)</title>
  <style>
    :root {
      --bg-start: __BG_START__;
      --bg-end: __BG_END__;
      --accent: __ACCENT__;
      --accent-soft: __ACCENT_SOFT__;
      --badge-bg: __BADGE_BG__;
      --badge-text: #ffffff;
      --card-bg: rgba(15, 23, 42, 0.78);
      --border: rgba(255, 255, 255, 0.16);
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      color: var(--text-main);
      background: radial-gradient(circle at top left, var(--bg-start), var(--bg-end) 65%);
    }

    .container {
      width: 100%;
      max-width: 780px;
      background: var(--card-bg);
      backdrop-filter: blur(14px);
      border: 1px solid var(--border);
      border-top: 6px solid var(--accent);
      border-radius: 18px;
      padding: 36px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }

    .header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--border);
    }

    .kicker {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent-soft);
      font-weight: 700;
      margin-bottom: 6px;
    }

    h1 {
      font-size: 1.85rem;
      font-weight: 750;
      letter-spacing: -0.02em;
    }

    .badges {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.92rem;
      background: var(--badge-bg);
      color: var(--badge-text);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .badge-outline {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border);
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 0 10px #ffffff;
    }

    .banner {
      background: rgba(255, 255, 255, 0.05);
      border-left: 4px solid var(--accent);
      border-radius: 10px;
      padding: 16px 18px;
      margin-bottom: 24px;
      line-height: 1.55;
      color: var(--text-muted);
    }

    .banner strong { color: var(--text-main); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
      margin-bottom: 26px;
    }

    .metric {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
    }

    .metric-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .metric-value {
      font-size: 1.08rem;
      font-weight: 700;
      word-break: break-word;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-top: 18px;
      border-top: 1px solid var(--border);
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .health-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.16);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #6ee7b7;
      font-weight: 600;
    }

    a { color: var(--accent-soft); text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <main class="container">
    <header class="header">
      <div>
        <div class="kicker">Kubernetes Service Traffic Routing Demo</div>
        <h1>__APP_NAME__</h1>
      </div>
      <div class="badges">
        <span class="badge"><span class="dot"></span> __APP_COLOR__</span>
        <span class="badge badge-outline">__APP_VERSION__</span>
      </div>
    </header>

    <section class="banner">
      <strong>Active Release Summary:</strong> __RELEASE_NOTE__
    </section>

    <section class="grid">
      <div class="metric">
        <div class="metric-label">Deployment Environment</div>
        <div class="metric-value">__APP_COLOR__</div>
      </div>
      <div class="metric">
        <div class="metric-label">Application Version</div>
        <div class="metric-value">__APP_VERSION__</div>
      </div>
      <div class="metric">
        <div class="metric-label">Serving Pod / Hostname</div>
        <div class="metric-value">__POD_NAME__</div>
      </div>
      <div class="metric">
        <div class="metric-label">Image Build Tag</div>
        <div class="metric-value">__BUILD_TAG__</div>
      </div>
      <div class="metric">
        <div class="metric-label">Container Started (UTC)</div>
        <div class="metric-value">__STARTED_AT__</div>
      </div>
      <div class="metric">
        <div class="metric-label">Kubernetes Selector</div>
        <div class="metric-value">app=myapp, color=__APP_COLOR_LOWER__</div>
      </div>
    </section>

    <footer class="footer">
      <span class="health-pill" id="health-status">Health Check: /health (OK)</span>
      <span>Endpoints: <a href="/health">/health</a> &bull; <a href="/api/info">/api/info</a></span>
    </footer>
  </main>

  <script>
    fetch('/health', { cache: 'no-store' })
      .then(r => r.json())
      .then(data => {
        const el = document.getElementById('health-status');
        if (data && data.status === 'healthy') {
          el.textContent = `Health Check: ${data.status.toUpperCase()} (${data.color} / ${data.version})`;
        }
      })
      .catch(() => {
        const el = document.getElementById('health-status');
        el.textContent = 'Health Check: unreachable';
      });
  </script>
</body>
</html>
